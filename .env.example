# UI password (basic protection for the dashboard)
APP_PASSWORD=change-me
# Secret used to sign session cookies
SESSION_SECRET=long-random-string
# HMAC secret shared with the mobile app for POST /webhooks/app
WEBHOOK_SECRET=another-long-random-string
# Secret key for pseudonymizing PII before anything reaches the LLM (HMAC key)
PII_HASH_KEY=yet-another-long-random-string
# Anthropic API key for the assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Where the SQLite file lives (Railway: mount a volume at /data)
DATA_DIR=./data
# "Today" for all time-based logic
CDP_TODAY=2026-09-28
PORT=3000
